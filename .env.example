# AI Chat Platform Environment Configuration

# Database
DATABASE_PATH=./data/chat.db

# Authentication Mode: 'single-user' or 'multi-user'
AUTH_MODE=single-user
AUTH_SECRET=super_secret_auth_token_change_in_production
# Optional single user password protection (leave empty for open VPS access)
APP_PASSWORD=

# VPS / Local AI Gateway Configuration
# Point this to your local LLM gateway or VPS endpoint (e.g. 9router, vLLM, Ollama, xKiro)
VPS_AI_BASE_URL=https://api.xkiro.com/v1
VPS_AI_API_KEY=sk-xt-ac072784f6eb982b9e11506867d210839388bcbf342a1dce
VPS_AI_NAME=xKiro AI (VPS)

# Default Settings
DEFAULT_PROVIDER=xkiro
DEFAULT_MODEL=qwen/qwen3.7-plus:free

# File Upload Limit (bytes, default 20MB)
MAX_UPLOAD_SIZE=20971520

# Node Environment
NODE_ENV=production
PORT=3010
